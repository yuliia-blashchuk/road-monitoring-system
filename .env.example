# Шаблон налаштувань. Скопіюй цей файл у .env і за потреби зміни значення.
# Файл .env НЕ потрапляє в Git (він у .gitignore) — там можуть бути паролі.

# --- База даних (PostgreSQL + PostGIS) ---
POSTGRES_USER=roadmap
POSTGRES_PASSWORD=roadmap
POSTGRES_DB=roadmap
# Для запуску бекенду без Docker. У Docker це значення перевизначається на "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Порт БД на твоєму комп'ютері. Якщо 5432 зайнятий — постав 5433.
DB_HOST_PORT=5432

# --- Застосунок ---
ENVIRONMENT=local
# Згенеруй свій: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
